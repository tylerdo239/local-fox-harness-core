# `./scripts/start.sh` (the supported way to run this app — see
# docs/getting-started.md) writes this file for you interactively on first
# run; copying this template and filling it in by hand is only needed for
# the advanced fields it doesn't ask about (OPENAI_EXTRA_BODY/
# OPENAI_CONTEXT_WINDOW) or if you're a developer using ./scripts/dev.sh
# instead (see README "Run it locally"). Either way, this file is picked up
# automatically by `docker compose -f deploy/docker-compose.yml up` (via the
# core service's env_file).
#
# The first 5 vars configure @cordis-app/llm-openai-compat, the default LLM
# route (see packages/llm/openai-compat/cordis.patch.yml for exactly how
# each one is wired in). The last 2 are for n8n — see docs/patch-cookbook.md
# "Ví dụ 4" for the full opt-in setup (n8n integration is off by default).

# Required for chat to work at all. Resolved via @deepseek-ai/dsh-credentials
# -local's own launch-environment fallback — no code change needed for this.
OPENAI_API_KEY=

# Optional — defaults to real OpenAI's own endpoint if unset. Point this at
# any OpenAI-compatible server (Azure OpenAI, Ollama, vLLM, LM Studio,
# OpenRouter, a hosted proxy, ...).
OPENAI_BASE_URL=

# Optional — defaults to a placeholder that fails clearly at request time
# (not at boot) if left unset. Must match a real model your OPENAI_BASE_URL
# server serves, e.g. hosted_vllm/Qwen/Qwen3.5-35B-A3B-FP8.
OPENAI_MODEL_ID=

# Optional — provider-specific tuning shallow-merged into every request
# body. Must be valid JSON if set (a boot-time error otherwise), e.g. for a
# vLLM/Qwen server:
# OPENAI_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
OPENAI_EXTRA_BODY=

# Optional — your model's real context window in tokens. Lets automatic
# compaction kick in before the provider rejects an oversized request;
# leaving it unset disables proactive compaction for this route.
OPENAI_CONTEXT_WINDOW=

# Only used once n8n integration is enabled (data/harness/profiles/cordis-app
# /cordis.patch.yml, docs/patch-cookbook.md "Ví dụ 4") — has no effect
# otherwise. A real n8n API key: n8n UI -> Settings -> API -> Create an API
# key. Needs more than n8n's own default scope suggestion — confirmed for
# real: missing tag:list still lets a workflow get created but the
# agent-generated tag step then 403s. Grant at least workflow:create/read
# /update/list/activate/deactivate, tag:create/read/update/list,
# workflowTags:update/list, execution:read/list.
N8N_API_KEY=

# Only used once n8n integration is enabled — a secret string YOU pick (not
# something n8n generates); any n8n workflow that calls back into this app's
# webhook must send it back via the `x-n8n-webhook-secret` header.
N8N_WEBHOOK_SECRET=
